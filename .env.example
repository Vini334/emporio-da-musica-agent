# Provider/model in the "<provider>:<model>" format (LangChain init_chat_model).
# Default: Gemini Flash (free tier). Get a key at https://aistudio.google.com/apikey
LLM_MODEL=google_genai:gemini-flash-latest
GOOGLE_API_KEY=

# Alternatives (uncomment and fill in the matching key; install the extra with
# `uv sync --extra anthropic` or `uv sync --extra openai`):
# LLM_MODEL=anthropic:claude-haiku-5-5
# ANTHROPIC_API_KEY=
# LLM_MODEL=openai:gpt-4.1-mini
# OPENAI_API_KEY=

# Optional: pins the agent's "now" (ISO 8601, America/Campo_Grande time zone).
# Useful to reproduce examples and evaluations. Empty = real clock.
# EMPORIO_NOW=2026-11-02T10:30:00
