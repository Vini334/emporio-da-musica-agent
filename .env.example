# Provedor/modelo no formato "<provider>:<model>" (LangChain init_chat_model).
# Padrão: Gemini Flash (free tier). Gere a chave em https://aistudio.google.com/apikey
LLM_MODEL=google_genai:gemini-flash-latest
GOOGLE_API_KEY=

# Alternativas (descomente e preencha a chave correspondente):
# LLM_MODEL=anthropic:claude-haiku-5-5
# ANTHROPIC_API_KEY=
# LLM_MODEL=openai:gpt-4.1-mini
# OPENAI_API_KEY=

# Opcional: fixa o "agora" do agente (ISO 8601, fuso America/Campo_Grande).
# Útil para reproduzir exemplos e avaliações. Vazio = relógio real.
# EMPORIO_NOW=2026-11-02T10:30:00
